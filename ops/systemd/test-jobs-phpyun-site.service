[Unit]
Description=PHPYun Nuxt site (Nitro) on :3004
After=network-online.target

[Service]
Type=simple
User=aa
Group=aa
WorkingDirectory=/www/wwwroot/zzzz.com/web/apps/site
Environment=PATH=/var/tmp/node-dist/node-v22.22.1-linux-arm64/bin:/usr/bin
Environment=TMPDIR=/var/tmp/npm-tmp
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3004
Environment=NITRO_HOST=127.0.0.1
Environment=NITRO_PORT=3004
Environment=RUST_API_URL=http://127.0.0.1:3003
Environment=NUXT_RUST_API=http://127.0.0.1:3003
Environment=NUXT_PUBLIC_SITE_URL=https://job1.ov6.com
ExecStart=/var/tmp/node-dist/node-v22.22.1-linux-arm64/bin/node /www/wwwroot/zzzz.com/web/apps/site/.output/server/index.mjs
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
