# Production configuration. Copy to `.env.pro`, replace every CHANGE_ME, and
# keep the resulting file out of Git with mode 0640 and ownership root:www.
APP_ENV=prod
BIND=127.0.0.1:3000
RUST_LOG=info,phpyun_core=info,phpyun_handlers=info,phpyun_services=info
WORKER_THREADS=0
THREAD_STACK_MB=2
MAX_BLOCKING_THREADS=512

# MySQL / Redis
DATABASE_URL=mysql://phpyun:CHANGE_ME@127.0.0.1:3306/phpyun
DATABASE_READER_URL=
DB_MAX_CONNECTIONS=32
DB_MIN_CONNECTIONS=4
DB_READER_MAX_CONNECTIONS=64
DB_ACQUIRE_TIMEOUT_SECS=5
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=1800
DB_TEST_BEFORE_ACQUIRE=true
DB_LOG_STATEMENTS=
REDIS_URL=redis://127.0.0.1:6379/0

# Runtime limits
HTTP_CLIENT_TIMEOUT_SECS=10
HTTP_CLIENT_POOL_MAX_IDLE=32
GLOBAL_CONCURRENCY_LIMIT=4096
REQUEST_TIMEOUT_SECS=30
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=200
MAX_BODY_MB=20
CACHE_USER_CAPACITY=10000
CACHE_USER_TTL_SECS=60

# Authentication
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_HEX_CHARACTERS
JWT_ACCESS_TTL_SECS=2592000
JWT_REFRESH_TTL_SECS=2592000

# Production policy
WEB_BASE_URL=https://zzzz.com
METRICS_BIND=127.0.0.1:9090
CORS_ALLOWED_ORIGINS=https://zzzz.com,https://www.zzzz.com
# Comma-separated lowercase User-Agent substrings that get a flat 403.
# Unset or blank = built-in crawler list; the literal `off` disables filtering.
# Do not add generic HTTP-library UAs (okhttp, java/, go-http-client):
# those identify our own mobile apps and server-to-server callers.
#BOT_UA_DENYLIST=
RUN_MIGRATIONS_ON_BOOT=false

# Open-platform client registry: app_id -> product line, scopes, rate tier.
# Unset path = no machine clients are recognised. The Redis key overrides the
# file wholesale so an integration can be cut off without a deploy.
#CLIENT_REGISTRY_PATH=config/client-registry.json
#CLIENT_REGISTRY_REDIS_KEY=client_registry:document
#CLIENT_REGISTRY_REFRESH_SECS=60
EVENTBUS_KIND=redis-stream

# Storage and external services
STORAGE_KIND=fs
STORAGE_FS_ROOT=/www/wwwroot/zzzz.com/uploads
STORAGE_BASE_URL=https://zzzz.com/files
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
SMS_KIND=noop
SMS_ALIYUN_AK=
SMS_ALIYUN_SK=
SMS_ALIYUN_SIGN=
PAYMENT_CALLBACK_TOKEN=

# Third-party integrations
WECHAT_TOKEN=
WECHAT_WELCOME_MESSAGE=
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_OAUTH_REDIRECT=
QQ_APPID=
QQ_APPSECRET=
QQ_OAUTH_REDIRECT=
WEIBO_APPID=
WEIBO_APPSECRET=
WEIBO_OAUTH_REDIRECT=
