[Unit]
Description=PHPYun Rust Backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=@@INSTALL_DIR@@
EnvironmentFile=@@ENV_FILE@@
ExecStart=@@INSTALL_DIR@@/bin/phpyun-rs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=65535
UMask=0027

[Install]
WantedBy=multi-user.target
