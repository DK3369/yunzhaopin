# Compatibility development template. Prefer copying `.env.dev.example` to
# `.env.dev`; the application no longer loads a plain `.env` by default.
APP_ENV=dev
BIND=0.0.0.0:3000
RUST_LOG=info,phpyun_handlers=debug
WORKER_THREADS=0
THREAD_STACK_MB=2
MAX_BLOCKING_THREADS=512

# MySQL / Redis
DATABASE_URL=mysql://phpyun:CHANGE_ME@127.0.0.1:3306/phpyun
DATABASE_READER_URL=
DB_MAX_CONNECTIONS=32
DB_MIN_CONNECTIONS=4
DB_READER_MAX_CONNECTIONS=64
DB_ACQUIRE_TIMEOUT_SECS=5
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=1800
DB_TEST_BEFORE_ACQUIRE=true
DB_LOG_STATEMENTS=
REDIS_URL=redis://127.0.0.1:6379/0

# Runtime limits
HTTP_CLIENT_TIMEOUT_SECS=10
HTTP_CLIENT_POOL_MAX_IDLE=32
GLOBAL_CONCURRENCY_LIMIT=4096
REQUEST_TIMEOUT_SECS=30
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=200
MAX_BODY_MB=20
CACHE_USER_CAPACITY=10000
CACHE_USER_TTL_SECS=60

# Authentication — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_32_BYTES
JWT_ACCESS_TTL_SECS=2592000
JWT_REFRESH_TTL_SECS=2592000

# Public endpoints and observability
WEB_BASE_URL=http://localhost:3000
METRICS_BIND=127.0.0.1:9090
CORS_ALLOWED_ORIGINS=*
RUN_MIGRATIONS_ON_BOOT=false

# Local development backends
STORAGE_KIND=fs
STORAGE_FS_ROOT=./uploads
STORAGE_BASE_URL=/files
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
EVENTBUS_KIND=memory
SMS_KIND=noop
SMS_ALIYUN_AK=
SMS_ALIYUN_SK=
SMS_ALIYUN_SIGN=
PAYMENT_CALLBACK_TOKEN=

# Third-party integrations
WECHAT_TOKEN=
WECHAT_WELCOME_MESSAGE=
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_OAUTH_REDIRECT=
QQ_APPID=
QQ_APPSECRET=
QQ_OAUTH_REDIRECT=
WEIBO_APPID=
WEIBO_APPSECRET=
WEIBO_OAUTH_REDIRECT=
