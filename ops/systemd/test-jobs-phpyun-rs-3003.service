[Unit]
Description=PHPYun Rust API on :3003 (jobs DB)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=aa
Group=aa
WorkingDirectory=/www/wwwroot/zzzz.com/phpyun-rs
Environment=PHPYUN_ENV_FILE=/www/wwwroot/zzzz.com/phpyun-rs/.env
Environment=BIND=127.0.0.1:3003
Environment=METRICS_BIND=127.0.0.1:9091
Environment=TMPDIR=/var/tmp/cargo-tmp
ExecStart=/www/wwwroot/zzzz.com/phpyun-rs/target/debug/phpyun-rs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
LimitNOFILE=65535
UMask=0027

[Install]
WantedBy=multi-user.target
