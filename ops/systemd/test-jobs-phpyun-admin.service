[Unit]
Description=PHPYun Nuxt admin (Nitro unix socket, no TCP port)
After=network-online.target

[Service]
Type=simple
User=aa
Group=aa
WorkingDirectory=/www/wwwroot/zzzz.com/web/apps/admin
Environment=PATH=/var/tmp/node-dist/node-v22.22.1-linux-arm64/bin:/usr/bin
Environment=TMPDIR=/var/tmp/npm-tmp
Environment=NODE_ENV=production
Environment=NITRO_UNIX_SOCKET=/var/tmp/phpyun-admin.sock
Environment=RUST_API_URL=http://127.0.0.1:3003
Environment=NUXT_RUST_API=http://127.0.0.1:3003
ExecStartPre=/bin/rm -f /var/tmp/phpyun-admin.sock
ExecStart=/var/tmp/node-dist/node-v22.22.1-linux-arm64/bin/node /www/wwwroot/zzzz.com/web/apps/admin/.output/server/index.mjs
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
