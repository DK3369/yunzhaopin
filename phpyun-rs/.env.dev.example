# Development and integration-test configuration. Copy to `.env.dev`.
# Both modes intentionally share this exact MySQL/Redis set.
APP_ENV=dev
BIND=0.0.0.0:3000
RUST_LOG=info,phpyun_handlers=debug,phpyun_services=debug
WORKER_THREADS=0
THREAD_STACK_MB=2
MAX_BLOCKING_THREADS=512

# MySQL / Redis
DATABASE_URL=mysql://phpyun:CHANGE_ME@127.0.0.1:3306/phpyun_test
DATABASE_READER_URL=
DB_MAX_CONNECTIONS=16
DB_MIN_CONNECTIONS=2
DB_READER_MAX_CONNECTIONS=16
DB_ACQUIRE_TIMEOUT_SECS=5
DB_IDLE_TIMEOUT_SECS=600
DB_MAX_LIFETIME_SECS=1800
DB_TEST_BEFORE_ACQUIRE=true
DB_LOG_STATEMENTS=
REDIS_URL=redis://127.0.0.1:6379/15

# Runtime limits
HTTP_CLIENT_TIMEOUT_SECS=10
HTTP_CLIENT_POOL_MAX_IDLE=16
GLOBAL_CONCURRENCY_LIMIT=1024
REQUEST_TIMEOUT_SECS=30
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=200
MAX_BODY_MB=20
CACHE_USER_CAPACITY=2000
CACHE_USER_TTL_SECS=60

# Authentication
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_HEX_CHARACTERS
JWT_ACCESS_TTL_SECS=2592000
JWT_REFRESH_TTL_SECS=2592000

# Public endpoints and observability
WEB_BASE_URL=http://127.0.0.1:3000
METRICS_BIND=127.0.0.1:9090
CORS_ALLOWED_ORIGINS=*
RUN_MIGRATIONS_ON_BOOT=false

# Development/test backends
STORAGE_KIND=fs
STORAGE_FS_ROOT=./uploads-dev
STORAGE_BASE_URL=/files
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
EVENTBUS_KIND=memory
SMS_KIND=noop
SMS_ALIYUN_AK=
SMS_ALIYUN_SK=
SMS_ALIYUN_SIGN=
PAYMENT_CALLBACK_TOKEN=

# Third-party integrations
WECHAT_TOKEN=
WECHAT_WELCOME_MESSAGE=
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_OAUTH_REDIRECT=
QQ_APPID=
QQ_APPSECRET=
QQ_OAUTH_REDIRECT=
WEIBO_APPID=
WEIBO_APPSECRET=
WEIBO_OAUTH_REDIRECT=
